# Bluesky Authentication
# Get your app password from: https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=your-bot-handle.bsky.social
BLUESKY_PASSWORD=your-app-password

# Database Connection
# Copy from the Railway Postgres service
DATABASE_URL=postgresql://username:password@host:port/database

# Post Milestone web app (no trailing slash)
SITE_URL=https://your-post-milestone-site.example

# Screenshot service
# Copy from your music-genre-ator app. The SITE_URL domain must be in the
# screenshot service's allowed domains list.
SCREENSHOT_SERVICE_URL=https://screenshot-service.fly.dev
SCREENSHOT_SERVICE_API_KEY=your-screenshot-api-key
SAVE_S3_BUCKET=screenshots-shared
SAVE_S3_REGION=eu-west-2

# Schedule (UTC)
# Day to send weekly progress updates: sunday-saturday or 0-6
WEEKLY_UPDATE_DAY=sunday
# Hour to send weekly updates and anniversary posts
SCHEDULED_POST_HOUR=12

# Limits
# Most posts to send in one run, the rest are sent on the next run
MAX_POSTS_PER_RUN=50
# Smallest milestone worth celebrating
MIN_MILESTONE=100

# Optional: Node environment
NODE_ENV=production
